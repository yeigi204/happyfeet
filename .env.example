# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Datenbank (Supabase Postgres; für Server-Zugriff die direkte bzw. Pooler-URL) ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/happyfeet

# ── Clerk ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhook-Endpunkt: /api/webhooks/clerk (Events: user.created, user.updated, user.deleted)
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Medien ───────────────────────────────────────────────────────────────────
# supabase = Supabase Storage (privater Bucket), local = Dateisystem unter .data/media (nur Dev)
STORAGE_DRIVER=local
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media
# Secret für signierte Medien-URLs des local-Drivers (min. 32 Zeichen)
MEDIA_SIGNING_SECRET=change-me-change-me-change-me-change-me

# ── Zahlungen ────────────────────────────────────────────────────────────────
# mock = simulierte Zahlungen (Grundgerüst). Später z. B. ccbill / segpay.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me-change-me-change-me-change-me

# ── Nur Entwicklung ──────────────────────────────────────────────────────────
# Umgeht Clerk und meldet diesen Seed-User an (wirkt NIE in Produktion; dort harter Fehler).
# Seed-User: seed_admin, seed_creator_1 … seed_creator_12, seed_fan_1 …
DEV_IMPERSONATE_CLERK_ID=
